{
  "nkip": 5,
  "version": "1",
  "note": "Expected results follow NKIP-0005 v1. Addresses are examples; nothing is resolved over the network.",
  "tokenize": [
    {
      "name": "plain",
      "content": "Buying $XMR today",
      "cashtags": [
        "XMR"
      ]
    },
    {
      "name": "lower and mixed case normalize",
      "content": "$xmr and $Btc",
      "cashtags": [
        "XMR",
        "BTC"
      ]
    },
    {
      "name": "first-seen order, no duplicates",
      "content": "$SOL $XMR $sol",
      "cashtags": [
        "SOL",
        "XMR"
      ]
    },
    {
      "name": "prices are not cashtags",
      "content": "it hit $562.82, then $5",
      "cashtags": []
    },
    {
      "name": "one letter is too short",
      "content": "$X marks it",
      "cashtags": []
    },
    {
      "name": "seven letters is too long",
      "content": "$ABCDEFG",
      "cashtags": []
    },
    {
      "name": "six letters is fine",
      "content": "$ABCDEF.",
      "cashtags": [
        "ABCDEF"
      ]
    },
    {
      "name": "digit after the letters",
      "content": "$XMR2 and $1INCH",
      "cashtags": []
    },
    {
      "name": "underscore after the letters",
      "content": "$XMR_ is not",
      "cashtags": []
    },
    {
      "name": "letter before the dollar sign",
      "content": "US$XMR",
      "cashtags": []
    },
    {
      "name": "double dollar sign",
      "content": "$$XMR",
      "cashtags": []
    },
    {
      "name": "non-ASCII letter after the letters",
      "content": "$XMRé",
      "cashtags": []
    },
    {
      "name": "non-ASCII letter inside",
      "content": "$XMÉR",
      "cashtags": []
    },
    {
      "name": "punctuation and emoji are boundaries",
      "content": "($XMR), $BTC! $ETH🚀 \"$SOL\"",
      "cashtags": [
        "XMR",
        "BTC",
        "ETH",
        "SOL"
      ]
    },
    {
      "name": "start and end of text",
      "content": "$ZEC",
      "cashtags": [
        "ZEC"
      ]
    },
    {
      "name": "inside a URL is not a cashtag",
      "content": "see https://example.com/q?$XMR and $BTC",
      "cashtags": [
        "BTC"
      ]
    },
    {
      "name": "inside a nostr entity is not a cashtag",
      "content": "nostr:npub1abc$xmr",
      "cashtags": []
    },
    {
      "name": "newline is a boundary",
      "content": "line\n$XMR\n",
      "cashtags": [
        "XMR"
      ]
    },
    {
      "name": "inline code is skipped",
      "content": "run `echo $HOME` then buy $XMR",
      "cashtags": [
        "XMR"
      ]
    },
    {
      "name": "fenced code block is skipped",
      "content": "```\nprice=$BTC\n```\n$SOL",
      "cashtags": [
        "SOL"
      ]
    },
    {
      "name": "unclosed fence runs to the end",
      "content": "$ETH ```\n$BTC",
      "cashtags": [
        "ETH"
      ]
    },
    {
      "name": "combining mark after the letters",
      "content": "$XMŔ is not",
      "cashtags": []
    },
    {
      "name": "combining mark before the dollar sign",
      "content": "é$XMR",
      "cashtags": []
    },
    {
      "name": "non-ASCII digit after the letters",
      "content": "$XMR٣",
      "cashtags": []
    },
    {
      "name": "non-ASCII digit before the dollar sign",
      "content": "٣$XMR",
      "cashtags": []
    },
    {
      "name": "superscript number after the letters",
      "content": "$XMR²",
      "cashtags": []
    }
  ],
